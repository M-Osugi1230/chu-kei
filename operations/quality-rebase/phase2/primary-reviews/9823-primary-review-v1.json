{"company":{"code":"9823","name":"マミーマートホールディングス"},"document":{"documentClassification":"formal_midterm_management_plan","documentType":"formal_midterm_management_plan","formalPlanConfirmed":true,"fullTextHumanReviewComplete":true,"publishedDate":"2026-11-20","sourceUrl":"https://www.release.tdnet.info/inbs/140120261120584216.pdf","title":"中期経営計画（2027～2029）"},"evidence":{"capitalAndShareholderReturnPage":26,"financialTargetsPage":7,"officialNoticePages":[1],"planIdentityPages":[1,6],"strategyPages":[9,10,13,16,19,20,21,23,24],"visualPagesReviewed":[1,7]},"formalPlanBoundary":{"reason":"2026年11月20日にTDnetで開示された資料（表題「中期経営計画（2027～2029）～さらなる差別化と収益性向上の両立～」）が、前中計の振り返りを含む新規の3カ年中期経営計画である。計画期間（2027年9月期～2029年9月期）、基本方針、2029年9月期の財務目標、キャピタルアロケーション、株主還元方針を一体で示しているため、正式な中期経営計画として確認した。財務目標はPDF p.1（エグゼクティブサマリー）とp.7（経営目標）の両方で照合済み。","status":"formal_midterm_management_plan_confirmed"},"review":{"automaticApprovalAllowed":false,"automaticFactCompletionAllowed":false,"deepVerificationApproved":false,"reviewRole":"primary_reviewer","reviewedAt":"2026-11-22T07:30:00+09:00","reviewers":["Muse primary review 2026-11-22"],"status":"primary_review_complete_formal_plan_confirmed_independent_visual_review_pending"},"schemaVersion":"deep-verification-primary-review-v1","structuredAnalysis":{"capitalPolicy":"営業キャッシュフロー約350億円を基本に、必要に応じて有利子負債約100億円＋αを活用し、成長投資約400億円（出店・改装75%、プロセスセンター・物流センター20%、DX・システム・労働環境整備5%）と株主還元約40億円を両立する。投資リターンと回収期間に基づく案件選別と投資後の継続的な検証を通じて資本効率の向上を図る。","financialTargets":[{"classification":"formal_plan_terminal_target","fiscalYear":"2029年9月期","metric":"営業収益","unit":"億円","value":3300},{"classification":"formal_plan_terminal_target","fiscalYear":"2029年9月期","metric":"経常利益率","unit":"%","value":3.5},{"classification":"formal_plan_terminal_target","fiscalYear":"2029年9月期","metric":"当期純利益","unit":"億円","value":80},{"classification":"formal_plan_terminal_target","fiscalYear":"2029年9月期","metric":"ROE","unit":"%以上","value":13},{"classification":"formal_plan_terminal_target","fiscalYear":"2029