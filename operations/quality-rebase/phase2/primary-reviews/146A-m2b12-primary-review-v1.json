{"company":{"code":"146A","name":"コロンビア・ワークス"},"document":{"documentClassification":"formal_mid_term_management_plan","documentType":"formal_mid_term_management_plan","formalPlanConfirmed":true,"fullTextHumanReviewComplete":true,"publishedDate":"2026-08-12","sourceUrl":"https://www2.jpx.co.jp/disc/146A0/140120260812517907.pdf","title":"中期経営計画（～2030年）"},"evidence":{"capitalAndShareholderReturnPage":27,"financialTargetsPage":10,"planIdentityPages":[1],"strategyPages":[3,14]},"formalPlanBoundary":{"reason":"2026年8月12日に開示された中期経営計画（～2030年）の本文（全33ページ）を照合した。計画期間（2026年12月期～2030年12月期）、2030年度の経営目標（EPS1,200円・営業利益200億円・ストック営業利益32億円・ROE24%超・PBR2.0倍超）、中間マイルストーン（2027年12月期 営業利益96億円・EPS654.07円）、株主還元方針が明示されており、正式な中期経営計画として確認した。候補だった2025年8月の説明会書き起こしは計画文書ではないため、後継の本計画文書を出典とした。","status":"formal_mid_term_management_plan_confirmed"},"review":{"automaticApprovalAllowed":false,"automaticFactCompletionAllowed":false,"deepVerificationApproved":false,"reviewedAt":"2026-11-21T01:50:00+09:00","reviewers":["Muse primary review 2026-11-21"],"status":"primary_review_complete_formal_plan_confirmed_independent_visual_review_pending"},"schemaVersion":"deep-verification-primary-review-v1","structuredAnalysis":{"capitalPolicy":"成長投資へ最優先で配分し、財務基盤の充実と安定的な株主還元を規律をもって両立させる。自己資本比率は20%～30%を維持し、外部資本の活用と運営事業の拡大により資本効率の向上を図る。","financialTargets":[{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"EPS","unit":"円","value":1200},{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"営業利益","unit":"億円","value":200},{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"ストック営業利益","unit":"億円","value":32},{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"ROE","unit":"%超","value":24.0},{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"PBR","unit":"倍超","value":2.0},{"classification":"formal_plan_terminal_target","fiscalYear":"2030年12月期","metric":"ROA（総資産経常利益率）","unit":"%～","value":10.0},{"classification":"formal_policy_intermediate_target","fiscalYear":"2027年12月期","metric":"営業利益","unit":"億円","value":96},{"classification":"formal_policy_intermediate_target","fiscalYear":"2027年12月期","metric":"EPS","unit":"円","value":654.07}],"nonFinancialTargets":[{"metric":"AUM","targetFiscalYear":"2030年12月期","value":"約4,000億円"},{"metric":"賃貸管理戸数","targetFiscalYear":"2030年12月期","value":"9,000戸"},{"metric":"客室数","targetFiscalYear":"2030年12月期","value":"800室"}],"period":"2026年12月期～2030年12月期","shareholderReturnPolicy":"配当性向15～20%を目安に、利益成長に応じた配当を実施する。利益の大部分を成長投資へ再投資し、中長期的なEPS成長を最重視する。","strategyThemes":["不動産開発事業の高ROE成長維持","不動産運営事業のストック収益拡大","M&Aによるバリューチェーン強化","資本コストを意識した経営"],"summary":"2030年12月期を最終年度とする5ヵ年の中期経営計画（2026年8月12日開示）。旧中計の最重要目標・営業利益75億円を1期前倒しで達成する見通しとなったことを受け、EPSを最重要指標に据えた新計画を策定。2030年度にEPS1,200円（26年度比約2.2倍）・営業利益200億円・ストック営業利益32億円・ROE24%超・PBR2.0倍超を目指し、KPIとしてAUM約4,000億円・賃貸管理戸数9,000戸・客室数800室を掲げる。"},"validation":{"companyIdentityConfirmed":true,"fieldLevelEvidenceLinked":true,"forecastActualSeparated":true,"formalPlanExistenceWithinGrowthDocumentChecked":true,"independentDoubleCheck":false,"metricsValidated":true,"postPublicationLinkAndRenderCheck":false,"publicationDateConfirmed":true,"scopeValidated":true,"strategyStructured":true,"templateTextRemaining":false,"unitValidated":true,"visualFigureReviewComplete":false,"yearValidated":true},"wave":"m2-batch12"}